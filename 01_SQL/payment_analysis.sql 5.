SELECT *
FROM payments.upi_transactions
LIMIT 10;

SELECT COUNT(*) AS total_transactions
FROM payments.upi_transactions;

SELECT column_name, data_type
FROM information_schema.columns
WHERE table_schema = 'payments'
AND table_name = 'upi_transactions'
ORDER BY ordinal_position;

SELECT
    COUNT(*) AS total_rows,
    COUNT("TransactionID") AS transaction_ids,
    COUNT("TransactionDate") AS transaction_dates,
    COUNT("Amount") AS transaction_amounts,
    COUNT("Status") AS transaction_statuses,
    COUNT("BankNameSent") AS sender_banks,
    COUNT("BankNameReceived") AS receiver_banks,
    COUNT("City") AS cities,
    COUNT("TransactionType") AS transaction_types
FROM payments.upi_transactions;

SELECT column_name
FROM information_schema.columns
WHERE table_schema = 'payments'
AND table_name = 'upi_transactions'
ORDER BY ordinal_position;


SELECT
    "TransactionID",
    COUNT(*) AS occurrences
FROM payments.upi_transactions
GROUP BY "TransactionID"
HAVING COUNT(*) > 1
ORDER BY occurrences DESC;

SELECT
    "Status",
    COUNT(*) AS transaction_count
FROM payments.upi_transactions
GROUP BY "Status"
ORDER BY transaction_count DESC;

SELECT
    COUNT(*) AS total_transactions,
    ROUND(SUM("Amount")::numeric, 2) AS total_transaction_value,
    ROUND(AVG("Amount")::numeric, 2) AS average_transaction_value,
    ROUND(MIN("Amount")::numeric, 2) AS smallest_transaction,
    ROUND(MAX("Amount")::numeric, 2) AS largest_transaction
FROM payments.upi_transactions;

SELECT
    "Status",
    COUNT(*) AS transaction_count,
    ROUND(SUM("Amount")::numeric, 2) AS total_value,
    ROUND(AVG("Amount")::numeric, 2) AS average_value
FROM payments.upi_transactions
GROUP BY "Status"
ORDER BY total_value DESC;

SELECT
    "PaymentMethod",
    COUNT(*) AS total_transactions,
    SUM(CASE
        WHEN "Status" = 'Success' THEN 1
        ELSE 0
    END) AS successful_transactions,
    SUM(CASE
        WHEN "Status" = 'Failed' THEN 1
        ELSE 0
    END) AS failed_transactions,
    ROUND(
        SUM(CASE WHEN "Status" = 'Failed' THEN 1 ELSE 0 END)::numeric
        / COUNT(*) * 100, 2
    ) AS failure_rate
FROM payments.upi_transactions
GROUP BY "PaymentMethod"
ORDER BY failure_rate DESC;

SELECT
    "BankNameSent",
    COUNT(*) AS total_transactions,
    SUM(CASE
        WHEN "Status" = 'Failed' THEN 1
        ELSE 0
    END) AS failed_transactions,
    ROUND(
        SUM(CASE WHEN "Status" = 'Failed' THEN 1 ELSE 0 END)::numeric
        / COUNT(*) * 100, 2
    ) AS failure_rate
FROM payments.upi_transactions
GROUP BY "BankNameSent"
ORDER BY failure_rate DESC;

SELECT
    "BankNameReceived",
